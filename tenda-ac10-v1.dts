// SPDX-License-Identifier: GPL-2.0-or-later
/*
 * Device Tree Source for Tenda AC10 V1.0 Router (Hybrid OpenWrt 4.14 / RTL8197FS)
 *
 * Target: Realtek RTL8197FS (MIPS 24KEc @ 1000 MHz, 64 MB DDR2 DRAM, 8 MB SPI NOR Flash)
 * Switch: Realtek RTL8367RB-VB Gigabit Switch (SMI on GPIO 18/19, Reset GPIO 58, CPU RGMII Port 6)
 * Wireless: Integrated RTL8197FS (2.4 GHz 2x2 b/g/n WMAC @ 0x18640000) + RTL8822BE (5 GHz 2x2 ac Wave 2, PCIe RC0)
 * RF Front-Ends: Skyworth RFE Type 6 (5 GHz External PA/LNA) + Skyworth RFE Type 5 (2.4 GHz)
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
	#address-cells = <1>;
	#size-cells = <1>;
	compatible = "tenda,ac10-v1", "realtek,rtl8197f-soc";
	model = "Tenda AC10 V1.0";

	memory {
		device_type = "memory";
		reg = <0x0 0x4000000>; /* 64 MB DDR2 DRAM */
	};

	chosen {
		bootargs = "console=ttyS0,38400";
	};

	cpus {
		cpu@0 {
			compatible = "mips,mips24KEc";
		};
	};

	cpuintc: cpuintc {
		#address-cells = <0>;
		#interrupt-cells = <1>;
		interrupt-controller;
		compatible = "mti,cpu-interrupt-controller";
	};

	soc {
		compatible = "simple-bus";
		ranges = <0x0 0x18000000 0x10000>;

		#address-cells = <1>;
		#size-cells = <1>;

		sysc: system-controller@0 {
			compatible = "realtek,rtl819x-sysc";
			reg = <0x0 0x1000>;
		};

		memc: memory-controller@1000 {
			compatible = "realtek,rtl819x-memc";
			reg = <0x1000 0x100>;
		};

		intc: intc@3000 {
			compatible = "realtek,rtl819x-intc";
			reg = <0x3000 0x100>;

			interrupt-controller;
			#interrupt-cells = <1>;

			interrupt-parent = <&cpuintc>;
			interrupts = <2>;
		};

		gpio0: gpio-controller@3500 {
			compatible = "realtek,rtl8197f-gpio";
			reg = <0x3500 0x1c>;
			gpio-controller;
			#gpio-cells = <2>;
			status = "okay";
		};

		gpio1: gpio-controller@351C {
			compatible = "realtek,rtl8197f-gpio";
			reg = <0x351C 0x1c>;
			gpio-controller;
			#gpio-cells = <2>;
			status = "okay";
		};
	};

	serial0: serial@18147000 {
		compatible = "realtek,rtl8197f-uart", "snps,dw-apb-uart";
		reg = <0x18147000 0x100>;

		interrupt-parent = <&intc>;
		interrupts = <9>;

		reg-io-width = <4>;
		reg-shift = <2>;
		clock-frequency = <100000000>;
	};

	spi0: spi@18143000 {
		compatible = "realtek,sheipa-spi";
		reg = <0x18143000 0x1000
		       0x10000000 0x2000000>;

		#address-cells = <1>;
		#size-cells = <0>;

		clock-frequency = <100000000>;
		status = "okay";

		m25p80@0 {
			#address-cells = <1>;
			#size-cells = <1>;
			compatible = "jedec,spi-nor";
			reg = <0>;
			spi-max-frequency = <41000000>;

			/* Realtek Booter v3.4.11B.9 */
			partition@0 {
				label = "bootloader";
				reg = <0x000000 0x020000>; /* 128 KB */
				read-only;
			};

			/* Factory RF calibration & board parameters (ASCII key-value) */
			partition@20000 {
				label = "calibration";
				reg = <0x020000 0x010000>; /* 64 KB */
				read-only;
			};

			/* Kernel + RootFS container (burn target at 0x30000 with cs6c/cr6c header) */
			partition@30000 {
				label = "firmware";
				reg = <0x030000 0x7b0000>; /* 7872 KB = 7.6875 MB */
			};

			/* Tenda CFM Primary NVRAM Configuration */
			partition@7e0000 {
				label = "cfm_primary";
				reg = <0x7e0000 0x010000>; /* 64 KB */
				read-only;
			};

			/* Tenda CFM Backup NVRAM Configuration */
			partition@7f0000 {
				label = "cfm_backup";
				reg = <0x7f0000 0x010000>; /* 64 KB */
				read-only;
			};
		};
	};

	ethernet: ethernet@18010000 {
		compatible = "realtek,rtl8197f-eth", "realtek,rtl819x-eth";
		reg = <0x18010000 0x100>;
		interrupt-parent = <&cpuintc>;
		interrupts = <4>;
	};

	pcie_clk: pcie_clk {
		#clock-cells = <0>;
		compatible = "fixed-clock";
		clock-frequency = <25000000>;
	};

	pcie0: pcie-controller@18b00000 {
		compatible = "realtek,rtl8196b-pci";
		#address-cells = <3>;
		#size-cells = <2>;
		bus-range = <0 255>;
		reg = <0x18b00000 0x1000>,
		      <0x18b01000 0x1000>,
		      <0x18b10000 0x1000>,
		      <0x18b11000 0x1000>;
		reg-names = "rc_cfg_base", "rc_ext_base", "dev_cfg0_base", "dev_cfg1_base";
		ranges = <0x02000000 0 0x00000000 0x19000000 0 0x01000000
			  0x01000000 0 0x00000000 0x18c00000 0 0x00200000>;
		interrupt-parent = <&cpuintc>;
		interrupts = <5>;
		clocks = <&pcie_clk>;
		status = "okay";
	};

	pcie1: pcie-controller@18b20000 {
		compatible = "realtek,rtl8196b-pci";
		#address-cells = <3>;
		#size-cells = <2>;
		bus-range = <0 255>;
		reg = <0x18b20000 0x1000>,
		      <0x18b21000 0x1000>,
		      <0x18b30000 0x1000>,
		      <0x18b31000 0x1000>;
		reg-names = "rc_cfg_base", "rc_ext_base", "dev_cfg0_base", "dev_cfg1_base";
		ranges = <0x02000000 0 0x00000000 0x1a000000 0 0x01000000
			  0x01000000 0 0x00000000 0x18e00000 0 0x00200000>;
		interrupt-parent = <&cpuintc>;
		interrupts = <6>;
		clocks = <&pcie_clk>;
		status = "disabled";
	};

	wmac: wmac@18640000 {
		compatible = "realtek,rtl8197f-wmac";
		reg = <0x18640000 0x10000>;
		interrupt-parent = <&cpuintc>;
		interrupts = <6>;
		clocks = <&pcie_clk>;
		status = "okay";
	};

	gpio-keys-polled {
		compatible = "gpio-keys-polled";
		#address-cells = <1>;
		#size-cells = <0>;
		poll-interval = <20>;

		reset {
			label = "reset";
			gpios = <&gpio1 22 GPIO_ACTIVE_LOW>; /* vendor GPIO 54 */
			linux,code = <KEY_RESTART>;
		};

		wps {
			label = "wps";
			gpios = <&gpio1 24 GPIO_ACTIVE_LOW>; /* vendor GPIO 56 */
			linux,code = <KEY_WPS_BUTTON>;
		};
	};

	gpio-leds {
		compatible = "gpio-leds";

		wps {
			label = "tenda:blue:wps";
			gpios = <&gpio0 22 GPIO_ACTIVE_LOW>;
		};
	};

	/*
	 * Realtek RTL8367RB-VB External 5-Port Gigabit Switch
	 *   MDC  (Clock) : GPIO 18 (gpio0 pin 18)
	 *   MDIO (Data)  : GPIO 19 (gpio0 pin 19)
	 *   RST  (Reset) : GPIO 58 (gpio1 pin 26, active-low)
	 *   CPU RGMII    : Port 6 (EXT_PORT_1, 1000M full-duplex, txDelay=0, rxDelay=2)
	 *   Physical Map : Port 3 = WAN (VID 1), Ports 2/1/0 = LAN1/LAN2/LAN3 (VID 2)
	 */
	rtl8367b {
		compatible = "realtek,rtl8367b";
		cpu_port = <6>;
		realtek,cpu-port = <6>;
		realtek,extif1 = <1 0 1 1 1 1 1 1 2>;
		gpio-sck = <&gpio0 18 GPIO_ACTIVE_HIGH>;
		gpio-sda = <&gpio0 19 GPIO_ACTIVE_HIGH>;
		realtek,smi-mdc-gpio = <&gpio0 18 GPIO_ACTIVE_HIGH>;
		realtek,smi-mdio-gpio = <&gpio0 19 GPIO_ACTIVE_HIGH>;
		realtek,reset-gpio = <&gpio0 58 GPIO_ACTIVE_LOW>;
		realtek,ext-rgmii-delay = <0x02>;
	};
};
